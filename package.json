{
  "name": "cf-nav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <27"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --env staging",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local --env staging",
    "seed:local": "node scripts/seed.mjs local",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
