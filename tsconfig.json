{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/worker/**/*.ts",
    "src/api/**/*.ts",
    "src/shared/**/*.ts",
    "src/health/**/*.ts",
    "tests/**/*.ts"
  ]
}
